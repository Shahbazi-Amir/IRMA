IRMA_APP_NAME=IRMA API
IRMA_APP_ENV=development
IRMA_LOG_LEVEL=INFO
IRMA_HOST=0.0.0.0
IRMA_PORT=8000
IRMA_DB_PASSWORD=change-this-local-password
IRMA_DATABASE_URL=sqlite:///./irma.db
IRMA_CORS_ORIGINS=http://localhost:8501
IRMA_ADMIN_KEY=
IRMA_API_BASE_URL=http://api:8000
IRMA_FUND_CSV_PATH=/app/data/imports/funds.csv
IRMA_MARKET_INDEX_CSV_PATH=/app/data/imports/market_indices.csv
IRMA_INSTRUMENT_MARKET_CSV_PATH=/app/data/imports/market_instruments.csv
IRMA_INFLATION_CSV_PATH=/app/data/imports/inflation.csv
IRMA_BANK_PRODUCT_CSV_PATH=/app/data/imports/bank_products.csv
IRMA_FUND_PROVIDER=csv
IRMA_FIPIRAN_BASE_URL=https://www.fipiran.com/services
IRMA_FUND_HISTORY_LIMIT=25
IRMA_PROVIDER_MIN_INTERVAL_SECONDS=0.25
IRMA_REFRESH_ENABLED=false
IRMA_REFRESH_INTERVAL_MINUTES=1440
IRMA_PROVIDER_TIMEOUT_SECONDS=15
IRMA_PROVIDER_MAX_RETRIES=2
IRMA_FIXTURE_DATA_ENABLED=false
IRMA_MAX_UPLOAD_BYTES=2000000
IRMA_HEAVY_RATE_LIMIT_PER_MINUTE=30
