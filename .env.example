IRMA_APP_NAME=IRMA API
IRMA_APP_ENV=development
IRMA_LOG_LEVEL=INFO
IRMA_HOST=0.0.0.0
IRMA_PORT=8000
IRMA_DB_PASSWORD=change-this-local-password
IRMA_DATABASE_URL=sqlite:///./irma.db
IRMA_CORS_ORIGINS=http://localhost:8501
IRMA_ADMIN_KEY=
IRMA_API_BASE_URL=http://api:8000
IRMA_FUND_CSV_PATH=/app/data/imports/funds.csv
IRMA_REFRESH_ENABLED=false
IRMA_REFRESH_INTERVAL_MINUTES=1440
IRMA_PROVIDER_TIMEOUT_SECONDS=15
IRMA_PROVIDER_MAX_RETRIES=2
