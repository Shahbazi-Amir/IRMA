IRMA_APP_NAME=IRMA API
IRMA_APP_ENV=development
IRMA_LOG_LEVEL=INFO
IRMA_HOST=0.0.0.0
IRMA_PORT=8000
IRMA_DB_PASSWORD=change-this-local-password
IRMA_DATABASE_URL=sqlite:///./irma.db
IRMA_CORS_ORIGINS=http://localhost:8501
IRMA_ADMIN_KEY=
# Local defaults. docker-compose.yml overrides these with /app paths.
IRMA_API_BASE_URL=http://127.0.0.1:8000
IRMA_FUND_CSV_PATH=data/imports/funds.csv
IRMA_MARKET_INDEX_CSV_PATH=data/imports/market_indices.csv
IRMA_INSTRUMENT_MARKET_CSV_PATH=data/imports/market_instruments.csv
IRMA_INFLATION_CSV_PATH=data/imports/inflation.csv
IRMA_BANK_PRODUCT_CSV_PATH=data/imports/bank_products.csv
IRMA_FUND_PROVIDER=csv
IRMA_FIPIRAN_BASE_URL=https://www.fipiran.com/services
IRMA_FUND_HISTORY_LIMIT=25
# Set true to backfill every active fund; LIMIT is then ignored.
IRMA_FUND_HISTORY_ALL=false
IRMA_PROVIDER_MIN_INTERVAL_SECONDS=0.25
IRMA_REFRESH_ENABLED=false
IRMA_REFRESH_INTERVAL_MINUTES=1440
IRMA_REFRESH_TARGETS_PER_DAY=3
IRMA_REFRESH_TIMEZONE=Asia/Tehran
IRMA_REFRESH_FRESH_MINUTES=180
IRMA_REFRESH_ADAPTIVE_LOOKBACK_DAYS=30
IRMA_REFRESH_MINIMUM_SAMPLES=4
IRMA_REFRESH_EXPLORATION_PERCENT=15
IRMA_REFRESH_JITTER_MINUTES=20
IRMA_REFRESH_MINIMUM_SPACING_HOURS=5
IRMA_REFRESH_LEASE_SECONDS=300
IRMA_REFRESH_TELEMETRY_RETENTION_DAYS=90
IRMA_PROVIDER_TIMEOUT_SECONDS=15
IRMA_PROVIDER_MAX_RETRIES=2
IRMA_FIPIRAN_CONTRACT=auto
IRMA_FIPIRAN_BASE_URL=https://www.fipiran.com/services
IRMA_FIPIRAN_CATALOG_PATH=fund/fundcompare/
IRMA_FIPIRAN_HISTORY_PATH=chart/getfundchart
IRMA_FIPIRAN_USER_AGENT=IRMA/1.0 (+https://github.com/Shahbazi-Amir/IRMA)
IRMA_PROVIDER_CIRCUIT_FAILURES=3
IRMA_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=300
IRMA_OFFICIAL_FUND_FILE_PATH=data/imports/official_funds.csv
IRMA_NAV_CONFLICT_WARNING_PERCENT=0.5
IRMA_NAV_CONFLICT_ERROR_PERCENT=2.0
IRMA_FIXTURE_DATA_ENABLED=false
IRMA_MAX_UPLOAD_BYTES=2000000
IRMA_HEAVY_RATE_LIMIT_PER_MINUTE=30
