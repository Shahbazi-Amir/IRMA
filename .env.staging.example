IRMA_APP_ENV=production
IRMA_LOG_LEVEL=INFO
IRMA_DB_PASSWORD=replace-in-secret-store
IRMA_DATABASE_URL=postgresql+psycopg://irma:replace-in-secret-store@database:5432/irma
IRMA_CORS_ORIGINS=https://staging.example.invalid
IRMA_ADMIN_KEY=replace-in-secret-store
IRMA_FUND_PROVIDER=fipiran
IRMA_FUND_HISTORY_LIMIT=5
IRMA_PROVIDER_TIMEOUT_SECONDS=15
IRMA_PROVIDER_MAX_RETRIES=2
IRMA_FIXTURE_DATA_ENABLED=false
